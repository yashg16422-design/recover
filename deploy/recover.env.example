# Copy to /etc/recover/recover.env on the server (owner root, chmod 600). Never commit real values.

# The fraud service (Lambda behind API Gateway). Output "BaseUrl" of the SAM stack. No trailing slash.
FRAUD_URL=https://REPLACE_WITH_API_ID.execute-api.ap-southeast-2.amazonaws.com
# Per-call timeout for the graph model. Kept generous at first; lower it after you measure warm latency.
FRAUD_TIMEOUT_MS=1500

# --- optional: thresholds (defaults shown) ---
# FRAUD_BLOCK_AT=0.8
# FRAUD_REVIEW_AT=0.5

# --- optional: messages ---
# SAFETY: send EVERY message to this address only, even for real customers' payments.
# TEST_RECIPIENT=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# HF_TOKEN=hf_...
# MERCHANT_NAME=Chai & Co

# --- optional: Stripe webhook. If you point Stripe at /webhooks/stripe, SET THIS: without it unsigned events are accepted.
# STRIPE_WEBHOOK_SECRET=whsec_...
# AUTO_RECOVER=false
